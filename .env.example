# Runtime identity
RUNTIME_NAME=yossarian-dev

# Model served by vLLM. Keep the first test deliberately modest for a 16 GB GPU.
VLLM_MODEL=Qwen/Qwen3-8B-AWQ
VLLM_SERVED_MODEL=local-general
VLLM_MAX_MODEL_LEN=8192
VLLM_GPU_MEMORY_UTILIZATION=0.80
VLLM_REASONING_PARSER=qwen3
# Qwen3-8B uses vLLM's Hermes-style tool-call parser for OpenAI auto tool choice.
VLLM_TOOL_CALL_PARSER=hermes

# Optional for Hugging Face rate limits/private models.
HF_TOKEN=

# Generated/filled by ./scripts/bootstrap.sh. Do not commit the real values.
VLLM_API_KEY=CHANGE_ME
LITELLM_MASTER_KEY=CHANGE_ME
LIBRECHAT_CREDS_KEY=CHANGE_ME
LIBRECHAT_CREDS_IV=CHANGE_ME
LIBRECHAT_JWT_SECRET=CHANGE_ME
LIBRECHAT_JWT_REFRESH_SECRET=CHANGE_ME
LIBRECHAT_OIDC_CLIENT_SECRET=CHANGE_ME
LIBRECHAT_OIDC_SESSION_SECRET=CHANGE_ME
KEYCLOAK_ADMIN_PASSWORD=CHANGE_ME
KEYCLOAK_TEST_USER_PASSWORD=CHANGE_ME
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=runtime
POSTGRES_USER=runtime
SPEACHES_API_KEY=CHANGE_ME
WEB_OIDC_CLIENT_SECRET=CHANGE_ME
WEB_SESSION_SECRET=CHANGE_ME
KNOWLEDGE_QUERY_TOKEN=CHANGE_ME
MONGODB_APP_PASSWORD=CHANGE_ME

# Development UI/API ports. All host-facing ports are loopback-only.
LITELLM_HOST_PORT=4000
LIBRECHAT_HOST_PORT=3080
LIBRECHAT_PUBLIC_URL=http://localhost:3080
LIBRECHAT_APP_TITLE="Yossarian"


# Runtime Web control surface. The browser talks only to this BFF; internal
# service credentials remain server-side.
WEB_HOST_PORT=8080
WEB_PUBLIC_URL=http://localhost:8080
WEB_OIDC_CLIENT_ID=runtime-web
WEB_OIDC_REQUIRED_ROLE=runtime-user
WEB_OIDC_ADMIN_ROLE=runtime-admin
WEB_COOKIE_SECURE=0

# Local OIDC stand-in. Production should normally use the organisation's IdP.
KEYCLOAK_REALM=yossarian-dev
KEYCLOAK_ADMIN_USER=admin
KEYCLOAK_TLS_HOST_PORT=8443
KEYCLOAK_PUBLIC_URL=https://auth.localhost:8443
LIBRECHAT_OIDC_CLIENT_ID=librechat
LIBRECHAT_OIDC_REQUIRED_ROLE=runtime-user

# Pinned runtime images for a reproducible development pass (checked 2026-09-03).
VLLM_IMAGE=vllm/vllm-openai:v0.28.0
LITELLM_IMAGE=ghcr.io/berriai/litellm:v1.98.0
LIBRECHAT_IMAGE=ghcr.io/danny-avila/librechat:v0.8.7
MONGODB_IMAGE=mongo:8.0.20
MONGODB_APP_USERNAME=librechat
KEYCLOAK_IMAGE=quay.io/keycloak/keycloak:26.7.3
CADDY_IMAGE=caddy:2.11.4
POSTGRES_IMAGE=pgvector/pgvector:0.8.6-pg18-bookworm
SPEACHES_IMAGE=ghcr.io/speaches-ai/speaches:0.9.0-rc.3-cpu@sha256:2163775b6df5e451a71200e8f675fed68dbd8ab184fc604453d549e486f22fd2

# Runtime release/audit metadata.
RUNTIME_VERSION=0.1.0


# Meeting resource service. Loopback-only in this development slice. Uploaded
# audio is deleted after successful processing unless MEETING_RETAIN_AUDIO=1
# is supplied by the client.
MEETINGS_HOST_PORT=8091
MEETING_MAX_UPLOAD_BYTES=2147483648


# Controlled public-web search. Disabled by default: offline deployments have
# no public-web egress. To enable the reference search tool, supply a Brave Search API
# key and explicitly flip the policy flag. Search queries then leave the runtime
# for Brave; result URLs are not fetched by this service.
WEB_SEARCH_ENABLED=0
WEB_SEARCH_PROVIDER=brave
BRAVE_SEARCH_API_KEY=
WEB_SEARCH_COUNTRY=AU
WEB_SEARCH_LANGUAGE=en
WEB_SEARCH_MAX_RESULTS=6
WEB_SEARCH_TIMEOUT_SECONDS=15
WEB_SEARCH_MAX_REQUESTS_PER_MINUTE=10
WEB_SEARCH_MAX_REQUESTS_PER_HOUR=50
WEB_SEARCH_MAX_REQUESTS_PER_DAY=100

# Development observability UI. Prometheus is loopback-only; exporters remain private.
PROMETHEUS_HOST_PORT=9090
PROMETHEUS_RETENTION=7d
# ./scripts/bootstrap.sh overwrites this with the checkout owner's primary GID.
PROMETHEUS_SECRET_GID=1000
PROMETHEUS_IMAGE=prom/prometheus:v3.14.0
DCGM_EXPORTER_IMAGE=nvcr.io/nvidia/k8s/dcgm-exporter:4.6.0-4.8.3-distroless

# Development auth rate limits: deliberately permissive while exercising OIDC.
LOGIN_MAX=50
LOGIN_WINDOW=1

# Permission-aware retrieval. The embedding model runs CPU-only and is cached.
KNOWLEDGE_EMBED_MODEL=BAAI/bge-small-en-v1.5

# Local speech-to-text. Speaches stays private to the runtime network and is
# used by Meetings and explicit transcription helpers. CPU is the development
# default so vLLM retains the GPU. LibreChat composer STT is disabled by
# default on the pinned v0.8.7; see README for the upstream schema/runtime bug.
SPEACHES_STT_MODEL=Systran/faster-distil-whisper-small.en
SPEACHES_STT_MODEL_TTL=-1
SPEACHES_ENABLE_DIARIZATION=1
SPEACHES_DIARIZATION_SEGMENTATION_MODEL=fedirz/segmentation_community_1
SPEACHES_DIARIZATION_EMBEDDING_MODEL=Wespeaker/wespeaker-voxceleb-resnet34-LM
SPEACHES_EXTRA_MODELS=

# Meeting processing uses the stable LiteLLM alias; change only if a deployment
# deliberately dedicates another local model to summarisation.
MEETING_SUMMARY_MODEL=general
MEETING_NORMALIZE_MODEL=general
