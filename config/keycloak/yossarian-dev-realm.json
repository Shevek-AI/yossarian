{
  "realm": "${KEYCLOAK_REALM}",
  "displayName": "Yossarian Dev",
  "enabled": true,
  "registrationAllowed": false,
  "loginWithEmailAllowed": true,
  "duplicateEmailsAllowed": false,
  "resetPasswordAllowed": false,
  "rememberMe": true,
  "roles": {
    "realm": [
      {
        "name": "runtime-user",
        "description": "Allowed to sign in to Yossarian"
      },
      {
        "name": "runtime-admin",
        "description": "Reserved for runtime administration"
      }
    ]
  },
  "clients": [
    {
      "clientId": "${LIBRECHAT_OIDC_CLIENT_ID}",
      "name": "LibreChat",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "secret": "${LIBRECHAT_OIDC_CLIENT_SECRET}",
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "fullScopeAllowed": true,
      "redirectUris": [
        "${LIBRECHAT_PUBLIC_URL}/oauth/openid/callback"
      ],
      "webOrigins": [
        "${LIBRECHAT_PUBLIC_URL}"
      ],
      "attributes": {
        "post.logout.redirect.uris": "${LIBRECHAT_PUBLIC_URL}/*"
      }
    },
    {
      "clientId": "${WEB_OIDC_CLIENT_ID}",
      "name": "Runtime Web",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "secret": "${WEB_OIDC_CLIENT_SECRET}",
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "fullScopeAllowed": true,
      "redirectUris": [
        "${WEB_PUBLIC_URL}/oauth/callback"
      ],
      "webOrigins": [
        "${WEB_PUBLIC_URL}"
      ],
      "attributes": {
        "post.logout.redirect.uris": "${WEB_PUBLIC_URL}/*"
      }
    }
  ],
  "users": [
    {
      "id": "11111111-1111-4111-8111-111111111111",
      "username": "allowed-user",
      "email": "allowed@example.test",
      "emailVerified": true,
      "enabled": true,
      "firstName": "Allowed",
      "lastName": "Engineering",
      "credentials": [
        {
          "type": "password",
          "value": "${KEYCLOAK_TEST_USER_PASSWORD}",
          "temporary": false
        }
      ],
      "realmRoles": [
        "runtime-user",
        "runtime-admin"
      ]
    },
    {
      "id": "22222222-2222-4222-8222-222222222222",
      "username": "finance-user",
      "email": "finance@example.test",
      "emailVerified": true,
      "enabled": true,
      "firstName": "Finance",
      "lastName": "User",
      "credentials": [
        {
          "type": "password",
          "value": "${KEYCLOAK_TEST_USER_PASSWORD}",
          "temporary": false
        }
      ],
      "realmRoles": [
        "runtime-user"
      ]
    },
    {
      "id": "33333333-3333-4333-8333-333333333333",
      "username": "staff-user",
      "email": "staff@example.test",
      "emailVerified": true,
      "enabled": true,
      "firstName": "Staff",
      "lastName": "User",
      "credentials": [
        {
          "type": "password",
          "value": "${KEYCLOAK_TEST_USER_PASSWORD}",
          "temporary": false
        }
      ],
      "realmRoles": [
        "runtime-user"
      ]
    },
    {
      "id": "44444444-4444-4444-8444-444444444444",
      "username": "denied-user",
      "email": "denied@example.test",
      "emailVerified": true,
      "enabled": true,
      "firstName": "Denied",
      "lastName": "User",
      "credentials": [
        {
          "type": "password",
          "value": "${KEYCLOAK_TEST_USER_PASSWORD}",
          "temporary": false
        }
      ]
    }
  ]
}
